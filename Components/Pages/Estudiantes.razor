@page "/estudiantes"
@using LP3.BlazorServer.Domain.Entities
@using LP3.BlazorServer.Application.Services
@inject IEstudianteService Service

<h3>Estudiantes</h3>

<button class="btn btn-primary" @onclick="Nuevo">Nuevo</button>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var e in estudiantes)
        {
            <tr>
                <td>@e.Id</td>
                <td>@e.Nombre</td>
                <td>
                    <button class="btn btn-warning" @onclick="() => Editar(e)">Editar</button>
                    <button class="btn btn-danger" @onclick="() => Eliminar(e.Id)">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (mostrarForm)
{
    <div class="card p-3">
        <input class="form-control" placeholder="Nombre" @bind="modelo.Nombre" />

        <br />

        <button class="btn btn-success" @onclick="Guardar">Guardar</button>
        <button class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
    </div>
}

@code {
    List<Estudiante> estudiantes = new();
    Estudiante modelo = new();
    bool mostrarForm = false;

    protected override async Task OnInitializedAsync()
    {
        estudiantes = await Service.GetAllAsync();
    }

    void Nuevo()
    {
        modelo = new Estudiante();
        mostrarForm = true;
    }

    void Editar(Estudiante e)
    {
        modelo = new Estudiante
        {
            Id = e.Id,
            Nombre = e.Nombre
        };

        mostrarForm = true;
    }

    async Task Guardar()
    {
        if (modelo.Id == 0)
            await Service.AddAsync(modelo);
        else
            await Service.UpdateAsync(modelo);

        estudiantes = await Service.GetAllAsync();
        mostrarForm = false;
    }

    async Task Eliminar(int id)
    {
        await Service.DeleteAsync(id);
        estudiantes = await Service.GetAllAsync();
    }

    void Cancelar()
    {
        mostrarForm = false;
    }
}