@page "/estudiantes"
@rendermode InteractiveServer
@using LP3.BlazorServer.Data
@using LP3.BlazorServer.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Gestión de Estudiantes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Estudiantes</h2>
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">Nuevo Estudiante</button>
    </div>

    @if (estudiantes == null)
    {
        <div class="text-center">
            <p>Cargando...</p>
        </div>
    }
    else if (!estudiantes.Any())
    {
        <div class="alert alert-info">No hay estudiantes registrados.</div>
    }
    else
    {
        <table class="table table-bordered bg-white">
            <thead class="table-dark">
                <tr>
                    <th>Matrícula</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var est in estudiantes)
                {
                    <tr>
                        <td>@est.Matricula</td>
                        <td>@est.Nombre</td>
                        <td>@est.Apellido</td>
                        <td>@est.Email</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => AbrirModalEditar(est)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarEstudiante(est)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(esEdicion ? "Modificar Estudiante" : "Registrar Nuevo Estudiante")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Matrícula</label>
                        <input type="text" class="form-control" @bind="nuevoEstudiante.Matricula" disabled="@esEdicion" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="nuevoEstudiante.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Apellido</label>
                        <input type="text" class="form-control" @bind="nuevoEstudiante.Apellido" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="text" class="form-control" @bind="nuevoEstudiante.Email" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-success" @onclick="GuardarEstudiante">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Estudiante>? estudiantes;
    private Estudiante nuevoEstudiante = new Estudiante();
    private bool mostrarModal = false;
    private bool esEdicion = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task CargarEstudiantes()
    {
        estudiantes = await DbContext.Estudiantes.ToListAsync();
    }

    private void AbrirModalNuevo()
    {
        nuevoEstudiante = new Estudiante();
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(Estudiante estudiante)
    {
        nuevoEstudiante = estudiante;
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarEstudiante()
    {
        if (esEdicion)
        {
            DbContext.Estudiantes.Update(nuevoEstudiante);
        }
        else
        {
            DbContext.Estudiantes.Add(nuevoEstudiante);
        }

        await DbContext.SaveChangesAsync();
        await CargarEstudiantes();
        CerrarModal();
    }

    private async Task EliminarEstudiante(Estudiante estudiante)
    {
        DbContext.Estudiantes.Remove(estudiante);
        await DbContext.SaveChangesAsync();
        await CargarEstudiantes();
    }
}
