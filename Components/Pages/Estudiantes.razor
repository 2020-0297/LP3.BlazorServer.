@page "/estudiantes"
@using LP3.BlazorServer.Domain.Entities
@using LP3.BlazorServer.Application.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IEstudianteService Service
@rendermode InteractiveServer

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Estudiantes</h2>
        <button class="btn btn-primary" @onclick="Nuevo">Nuevo Estudiante</button>
    </div>

    <table class="table table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Matrícula</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Email</th>
                <th class="text-center" style="width: 180px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (estudiantes == null || !estudiantes.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Cargando estudiantes...</td>
                </tr>
            }
            else
            {
                @foreach (var e in estudiantes)
                {
                    <tr>
                        <td>@e.Matricula</td>
                        <td>@e.Nombre</td>
                        <td>@e.Apellido</td>
                        <td>@e.Email</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2 text-dark fw-bold" @onclick="() => Editar(e)">Editar</button>
                            <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(e.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (mostrarForm)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content p-3">
                <div class="modal-header">
                    <h5 class="modal-title">@(modelo.Id == 0 ? "Nuevo Estudiante" : "Editar Estudiante")</h5>
                    <button type="button" class="btn-close" @onclick="Cancelar"></button>
                </div>
                
                <EditForm Model="modelo" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger mb-3" />

                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Matrícula</label>
                            <InputText class="form-control" @bind-Value="modelo.Matricula" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="modelo.Nombre" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Apellido</label>
                            <InputText class="form-control" @bind-Value="modelo.Apellido" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText class="form-control" type="email" @bind-Value="modelo.Email" />
                        </div>
                    </div>
                    
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Guardar</button>
                        <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    List<Estudiante> estudiantes = new();
    Estudiante modelo = new();
    bool mostrarForm = false;

    protected override async Task OnInitializedAsync()
    {
        estudiantes = await Service.GetAllAsync() ?? new List<Estudiante>();
    }

    void Nuevo()
    {
        modelo = new Estudiante();
        mostrarForm = true;
    }

    void Editar(Estudiante e)
    {
        modelo = new Estudiante
        {
            Id = e.Id,
            Matricula = e.Matricula,
            Nombre = e.Nombre,
            Apellido = e.Apellido,
            Email = e.Email,
            Estado = e.Estado,
            FechaIngreso = e.FechaIngreso,
            CreadoEn = e.CreadoEn
        };

        mostrarForm = true;
    }

    async Task Guardar()
    {
        if (modelo.Id == 0)
            await Service.AddAsync(modelo);
        else
            await Service.UpdateAsync(modelo);

        estudiantes = await Service.GetAllAsync() ?? new List<Estudiante>();
        mostrarForm = false;
        StateHasChanged();
    }

    async Task Eliminar(int id)
    {
        await Service.DeleteAsync(id);
        estudiantes = await Service.GetAllAsync() ?? new List<Estudiante>();
        StateHasChanged();
    }

    void Cancelar()
    {
        mostrarForm = false;
    }
}
