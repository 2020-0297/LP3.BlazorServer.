@page "/estudiantes"
@rendermode InteractiveServer
@using LP3.BlazorServer.Data
@using LP3.BlazorServer.Domain.Entities
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext

<PageTitle>Gestión de Estudiantes</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Listado de Estudiantes</h2>
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-circle"></i> Nuevo Estudiante
        </button>
    </div>

    @if (estudiantes == null)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (!estudiantes.Any())
    {
        <div class="alert alert-info">No hay estudiantes registrados en el sistema actualmente.</div>
    }
    else
    {
        <table class="table table-hover table-bordered shadow-sm bg-white">
            <thead class="table-dark">
                <tr>
                    <th>Matrícula</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Email</th>
                    <th class="text-center" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var est in estudiantes)
                {
                    <tr>
                        <td><strong>@est.Matricula</strong></td>
                        <td>@est.Nombre</td>
                        <td>@est.Apellido</td>
                        <td>@est.Email</td>
                        <td class="text-center">
                            <button class="btn btn-warning btn-sm me-2" @onclick="() => AbrirModalEditar(est)">
                                <i class="bi bi-pencil-square"></i> Editar
                            </button>
                            <button class="btn btn-danger btn-sm" @onclick="() => EliminarEstudiante(est)">
                                <i class="bi bi-trash"></i> Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog mt-5" style="max-width: 500px;">
            <div class="modal-content shadow">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">@(esEdicion ? "Modificar Estudiante" : "Registrar Nuevo Estudiante")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <EditForm Model="@nuevoEstudiante" OnValidSubmit="GuardarEstudiante">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <ValidationSummary class="alert alert-danger p-2" style="font-size: 0.9rem;" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Matrícula</label>
                            <InputText class="form-control" @bind-Value="nuevoEstudiante.Matricula" disabled="@esEdicion" />
                            <ValidationMessage For="@(() => nuevoEstudiante.Matricula)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre</label>
                            <InputText class="form-control" @bind-Value="nuevoEstudiante.Nombre" />
                            <ValidationMessage For="@(() => nuevoEstudiante.Nombre)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Apellido</label>
                            <InputText class="form-control" @bind-Value="nuevoEstudiante.Apellido" />
                            <ValidationMessage For="@(() => nuevoEstudiante.Apellido)" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Correo Electrónico</label>
                            <InputText class="form-control" @bind-Value="nuevoEstudiante.Email" />
                            <ValidationMessage For="@(() => nuevoEstudiante.Email)" class="text-danger" />
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="submit" class="btn btn-success">Guardar Cambios</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Estudiante>? estudiantes;
    private Estudiante nuevoEstudiante = new Estudiante();
    private bool mostrarModal = false;
    private bool esEdicion = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstudiantes();
    }

    private async Task CargarEstudiantes()
    {
        estudiantes = await DbContext.Estudiantes.ToListAsync();
    }

    private void AbrirModalNuevo()
    {
        nuevoEstudiante = new Estudiante();
        esEdicion = false;
        mostrarModal = true;
    }

    private void AbrirModalEditar(Estudiante estudiante)
    {
        // Clonamos el objeto para no modificar la tabla en tiempo real si cancelan
        nuevoEstudiante = new Estudiante
        {
            Matricula = estudiante.Matricula,
            Nombre = estudiante.Nombre,
            Apellido = estudiante.Apellido,
            Email = estudiante.Email
        };
        esEdicion = true;
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }

    private async Task GuardarEstudiante()
    {
        if (esEdicion)
        {
            var estudianteExistente = await DbContext.Estudiantes.FindAsync(nuevoEstudiante.Matricula);
            if (estudianteExistente != null)
            {
                estudianteExistente.Nombre = nuevoEstudiante.Nombre;
                estudianteExistente.Apellido = nuevoEstudiante.Apellido;
                estudianteExistente.Email = nuevoEstudiante.Email;
                DbContext.Estudiantes.Update(estudianteExistente);
            }
        }
        else
        {
            DbContext.Estudiantes.Add(nuevoEstudiante);
        }

        await DbContext.SaveChangesAsync();
        await CargarEstudiantes();
        CerrarModal();
    }

    private async Task SliminarEstudiante(Estudiante estudiante)
    {
        // Corregido el nombre interno del método para mapear bien el click
        var est = await DbContext.Estudiantes.FindAsync(estudiante.Matricula);
        if (est != null)
        {
            DbContext.Estudiantes.Remove(est);
            await DbContext.SaveChangesAsync();
            await CargarEstudiantes();
        }
    }

    private async Task EliminarEstudiante(Estudiante estudiante)
    {
        await SliminarEstudiante(estudiante);
    }
}
